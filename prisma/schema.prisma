generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MaterialStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum QuestionType {
  MCQ
  OPEN
}

enum AIStatus {
  SUCCESS
  FAILURE
}

// ---------------------------------------------------------------------------
// Core
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spaces          Space[]
  conversations   Conversation[]
  quizAttempts    QuizAttempt[]
  masteries       Mastery[]
  recommendations Recommendation[]
  activityEvents  ActivityEvent[]
  aiUsageLogs     AIUsageLog[]
}

model Space {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  spaceId     String
  userId      String
  name        String
  description String?
  goal        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  materials       Material[]
  chunks          Chunk[]
  concepts        Concept[]
  conversations   Conversation[]
  quizzes         Quiz[]
  masteries       Mastery[]
  recommendations Recommendation[]
  activityEvents  ActivityEvent[]
  aiUsageLogs     AIUsageLog[]

  @@index([userId])
  @@index([userId, spaceId])
}

// ---------------------------------------------------------------------------
// Materials / RAG
// ---------------------------------------------------------------------------

model Material {
  id           String         @id @default(cuid())
  projectId    String
  userId       String
  title        String
  fileUrl      String
  fileType     String
  status       MaterialStatus @default(QUEUED)
  errorMessage String?
  pageCount    Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks   Chunk[]
  concepts Concept[]

  @@index([userId, projectId])
}

model Chunk {
  id         String                    @id @default(cuid())
  materialId String
  projectId  String
  content    String
  embedding  Unsupported("vector(384)")?
  pageNumber Int
  tokenCount Int?
  createdAt  DateTime                  @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([projectId])
}

model Concept {
  id          String                       @id @default(cuid())
  projectId   String
  materialId  String?
  name        String
  description String?
  // Cached embedding of (name + description), computed once so quiz question generation and
  // grading don't re-embed the same never-changing text on every call. See shared/src/quiz.ts.
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime                     @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  masteries     Mastery[]
  quizQuestions QuizQuestion[]

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Mastery (history table — never overwritten in place)
// ---------------------------------------------------------------------------

model Mastery {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  conceptId     String
  score         Int
  evidenceCount Int
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@index([conceptId, createdAt])
}

// ---------------------------------------------------------------------------
// Tutor
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  title     String?
  summary   String? // running summary of older turns, updated periodically
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, projectId])
}

model Message {
  id                 String      @id @default(cuid())
  conversationId     String
  role               MessageRole
  content            String
  citations          Json?
  sufficientEvidence Boolean?
  createdAt          DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Quizzes / Assessment
// ---------------------------------------------------------------------------

model Quiz {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([userId, projectId])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  conceptId     String
  type          QuestionType
  difficulty    Int
  prompt        String
  options       Json?
  correctAnswer String
  createdAt     DateTime     @default(now())

  quiz    Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  concept Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([quizId])
  @@index([conceptId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizQuestionId String
  userId         String
  answer         String
  score          Int?
  feedback       Json?
  createdAt      DateTime @default(now())

  quizQuestion QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizQuestionId])
}

// ---------------------------------------------------------------------------
// Recommendations / Activity / Observability
// ---------------------------------------------------------------------------

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  action    String
  rationale String
  conceptId String?
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@index([type, createdAt])
}

model AIUsageLog {
  id             String   @id @default(cuid())
  userId         String?
  projectId      String?
  feature        String
  provider       String
  model          String
  latencyMs      Int
  inputTokens    Int?
  outputTokens   Int?
  estimatedCost  Float?
  status         AIStatus
  errorMessage   String?
  createdAt      DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, projectId])
  @@index([feature, createdAt])
  @@index([status, createdAt])
}
