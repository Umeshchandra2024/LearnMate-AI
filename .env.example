# ---- Database ---- 
DATABASE_URL="postgresql://user:password@localhost:5432/ai_study_companion?schema=public"

# ---- Redis (shared by BullMQ + cache) ----
# Local redis-server: "redis://localhost:6379"
# Hosted providers (e.g. Upstash) usually require TLS: use "rediss://" (note the extra "s"),
# not "redis://" — with a plain scheme, ioredis/BullMQ will hang on every command instead of
# erroring, since maxRetriesPerRequest is unset for BullMQ compatibility.
REDIS_URL="redis://localhost:6379"

# ---- Auth ---- 
JWT_SECRET="replace-with-a-long-random-string" 
JWT_EXPIRES_IN="7d" COOKIE_NAME="asc_token" 

# ---- LLM providers ----
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Smaller/faster model for latency-sensitive, lower-stakes calls (quiz generation + grading).
# Check what's actually available on your Groq account (models get deprecated over time):
# curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# ---- Embeddings ---- 
EMBEDDINGS_PROVIDER="huggingface" 
EMBEDDINGS_MODEL="BAAI/bge-small-en-v1.5" 
EMBEDDINGS_DIMENSIONS="384" 
HUGGINGFACEHUB_API_TOKEN=""

# ---- File storage (Cloudinary) ---- 
CLOUDINARY_CLOUD_NAME="" 
CLOUDINARY_API_KEY="" 
CLOUDINARY_API_SECRET="" 

# ---- Server ---- 
PORT=4000 
NODE_ENV="development" 
CLIENT_ORIGIN="http://localhost:5173"